@startuml
left to right direction

title CUS09 - Iniciar sesión con usuario y contraseña

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false

skinparam actorStyle stickman

skinparam usecase {
    BackgroundColor #EAF4FF
    BorderColor #B5D4F5
    FontColor #333333
    ArrowColor #555555
}

skinparam rectangle {
    BorderColor #555555
    BackgroundColor white
}

actor "Usuario" as USER

rectangle {

    usecase "Iniciar sesión con\nusuario y contraseña" as CUSIGNIN

    usecase "Validar credenciales\ningresadas" as UC01

    usecase "Consultar usuario\npor username" as UC02

    usecase "Verificar estado y\ncontraseña del usuario" as UC03

    usecase "Obtener roles y\npermisos del usuario" as UC04

    usecase "Generar token\nde acceso JWT" as UC05

    usecase "Presentar resultado\nde autenticación" as UC06

    usecase "Permitir acceso\nal sistema" as UC07

    usecase "Mostrar mensaje de\ncredenciales inválidas" as UC08

}

USER --> CUSIGNIN

CUSIGNIN ..> UC01 : <<include>>
CUSIGNIN ..> UC02 : <<include>>
CUSIGNIN ..> UC03 : <<include>>
CUSIGNIN ..> UC04 : <<include>>
CUSIGNIN ..> UC05 : <<include>>
CUSIGNIN ..> UC06 : <<include>>

UC06 ..> UC07 : <<extend>>
UC06 ..> UC08 : <<extend>>
@enduml
