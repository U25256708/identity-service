@startuml
left to right direction

title CUS02 - Consulta de usuarios

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam actorStyle stickman
skinparam usecase {
    BackgroundColor #EAF4FF
    BorderColor #B5D4F5
    FontColor #333333
    ArrowColor #555555
}
skinparam rectangle {
    BorderColor #555555
    BackgroundColor white
}

actor "Usuario autorizado" as USER

rectangle {
    usecase "Consultar usuarios" as CUSLIST
    usecase "Verificar rol y permisos\ndel solicitante" as UC01
    usecase "Consultar usuarios con\nroles y permisos" as UC02
    usecase "Presentar listado\nde usuarios" as UC03
    usecase "Mostrar acceso\nno autorizado" as UC04
    usecase "Mostrar listado\nsin resultados" as UC05
}

USER --> CUSLIST
CUSLIST ..> UC01 : <<include>>
CUSLIST ..> UC02 : <<include>>
CUSLIST ..> UC03 : <<include>>
UC01 ..> UC04 : <<extend>>
UC03 ..> UC05 : <<extend>>
@enduml
