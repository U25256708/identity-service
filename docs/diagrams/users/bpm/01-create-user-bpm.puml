@startuml
title BPM 01 - Registro de usuario

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor black
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
    StartColor black
    EndColor black
}

|Administrador|
start
:Acceder a la pantalla\nde usuarios;
|Sistema|
:Mostrar el listado y la opción\n«Crear usuario»;
|Administrador|
:Seleccionar «Crear usuario»;
|Sistema|
:Mostrar formulario\nde registro;
|Administrador|
:Completar los datos\ndel usuario;
:Confirmar registro;
|Sistema|
:Validar los datos ingresados;
if (¿Datos válidos?) then (Sí)
    :Enviar solicitud\nde registro;
    if (¿Registro exitoso?) then (Sí)
        :Mostrar confirmación\ndel registro;
        :Actualizar el listado\nde usuarios;
    else (No)
        :Mostrar el error informado\ny conservar los datos ingresados;
    endif
else (No)
    :Resaltar los campos inválidos\ny mostrar indicaciones;
endif
|Administrador|
:Visualizar el resultado;
stop
@enduml
