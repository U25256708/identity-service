@startuml
title BPM 09 - Inicio de sesión con usuario y contraseña

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor black

skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
    StartColor black
    EndColor black
}

|Usuario|

start

:Acceder a la pantalla de
inicio de sesión;

:Ingresar username
y contraseña;

:Confirmar inicio
de sesión;

|Sistema|

:Recibir credenciales con
type=USERNAME_PASSWORD;

:Buscar usuario
por username;

if (¿Usuario registrado y activo?) then (Sí)

    :Comparar la contraseña ingresada
    con la contraseña protegida;

    if (¿Contraseña válida?) then (Sí)

        :Obtener roles y permisos
        del usuario;

        :Generar token de acceso JWT
        y tiempo de vigencia;

        :Devolver token, vigencia
        y permisos;

        |Usuario|

        :Ingresar al sistema;

    else (No)

        |Sistema|

        :Mostrar mensaje de
        credenciales inválidas;

        |Usuario|

        :Visualizar error
        de autenticación;

    endif

else (No)

    |Sistema|

    :Mostrar mensaje de
    credenciales inválidas;

    |Usuario|

    :Visualizar error
    de autenticación;

endif

stop
@enduml
