@startuml
title BPM 09 - Inicio de sesión con usuario y contraseña

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor black

skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
    StartColor black
    EndColor black
}

|Usuario|
start
:Acceder a la pantalla de
inicio de sesión;
:Ingresar username
y contraseña;
:Confirmar inicio
de sesión;
|Sistema|
:Validar los campos
ingresados;
if (¿Campos válidos?) then (Sí)
    :Enviar solicitud de
inicio de sesión;
    :Mostrar indicador
de carga;
    if (¿Autenticación exitosa?) then (Sí)
        :Guardar la sesión
del usuario;
        :Redirigir a la pantalla
principal;
    else (No)
        :Mostrar el error informado
y conservar el username;
    endif
else (No)
    :Resaltar los campos inválidos
y mostrar indicaciones;
endif
|Usuario|
:Visualizar el resultado;
stop
@enduml
