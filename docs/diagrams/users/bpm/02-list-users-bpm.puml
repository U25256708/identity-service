@startuml
title BPM 02 - Consulta de usuarios

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor black
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
    StartColor black
    EndColor black
}

|Usuario autorizado|
start
:Acceder a la pantalla\nde usuarios;
|Sistema|
:Mostrar indicador\nde carga;
:Solicitar el listado\nde usuarios;
if (¿Consulta exitosa?) then (Sí)
    if (¿Existen usuarios?) then (Sí)
        :Mostrar el listado\nde usuarios;
    else (No)
        :Mostrar estado vacío\ndel listado;
    endif
else (No)
    :Mostrar mensaje de error\ny opción para reintentar;
endif
|Usuario autorizado|
:Visualizar el resultado;
stop
@enduml
