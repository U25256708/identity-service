@startuml
title BPM 10 - Búsqueda paginada de usuarios internos

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor black

skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
    StartColor black
    EndColor black
}

|Usuario autorizado|
start
:Acceder a la pantalla
de usuarios;
:Escribir el término de búsqueda
y seleccionar los campos a filtrar;
:Seleccionar el tamaño de página
y el orden de los resultados;
:Confirmar la búsqueda;
|Sistema|
:Validar los criterios,
la página y el orden;
if (¿Parámetros válidos?) then (Sí)
    :Enviar solicitud
de búsqueda;
    :Mostrar indicador
de carga;
    if (¿Búsqueda exitosa?) then (Sí)
        if (¿Existen resultados?) then (Sí)
            :Mostrar la página de resultados
con el resumen de paginación;
        else (No)
            :Mostrar estado vacío
de resultados;
        endif
    else (No)
        :Mostrar mensaje de error
y opción para reintentar;
    endif
else (No)
    :Mostrar indicaciones sobre
los parámetros inválidos;
endif
|Usuario autorizado|
:Visualizar el resultado;
stop
@enduml
